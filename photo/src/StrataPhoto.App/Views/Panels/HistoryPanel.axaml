<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:StrataPhoto.App.ViewModels.Panels"
             xmlns:views="using:StrataPhoto.App.Views"
             xmlns:theme="using:Strata.Ui"
             x:Class="StrataPhoto.App.Views.Panels.HistoryPanel"
             x:DataType="panels:HistoryPanelViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" Margin="0,4,0,0">
      <Button Classes="icon" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)" Focusable="False">
        <theme:IconView Icon="undo" />
      </Button>
      <Button Classes="icon" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Shift+Z)" Focusable="False">
        <theme:IconView Icon="redo" />
      </Button>
    </StackPanel>
    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="panels:HistoryItem">
          <StackPanel Orientation="Horizontal" Spacing="8" Height="22" Opacity="{Binding IsUndone, Converter={x:Static views:DimConverter.Instance}}">
            <theme:IconView Icon="{Binding Icon}" Width="13" Height="13" Foreground="{DynamicResource Strata.textDimBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
