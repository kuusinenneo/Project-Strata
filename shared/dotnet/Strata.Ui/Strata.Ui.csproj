<Project Sdk="Microsoft.NET.Sdk">
  <!-- Strata look for the .NET apps: shared/theme.json -> Avalonia/Fluent/Dock resources, the shared
       SVG icon set, common styles and controls. Used by Strata Photo and Strata PDF. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Strata.Ui</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Styles.axaml" />
  </ItemGroup>
  <!-- Apps get shared/theme.json and the icons copied next to their exe. -->
  <ItemGroup>
    <None Include="..\..\theme.json" Link="shared\theme.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\icons\*.svg" Link="shared\icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
